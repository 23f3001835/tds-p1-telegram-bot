TELEGRAM_BOT_TOKEN=123456:your-botfather-token
LOG_FILE_PATH=run.jsonl

# Web search — highly recommended: get a free key from https://tavily.com
# (1000 free searches/month, no card needed). Without this, search falls back
# to scraping DuckDuckGo, which gets rate-limited quickly.
TAVILY_API_KEY=tvly-your-key

# Set PROVIDER to exactly one of: vertex | anthropic | aipipe

# --- Option A: direct Anthropic API (costs money) ---
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key

# --- Option B: Google Cloud Vertex AI (uses your $300 GCP credit) ---
# PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=global

# --- Option C: AI Pipe (for IIT Madras students, study.iitm.ac.in email) ---
# PROVIDER=aipipe
# AIPIPE_TOKEN=your-aipipe-token-from-aipipe.org/login

# --- Option D: Google AI Studio (genuinely free, no billing/credit card needed) ---
# PROVIDER=gemini
# GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey

# --- Option E: direct OpenAI API (uses your own OpenAI credits) ---
PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini   # cheap + reliable tool-calling; override if you want a different one
# Public raw URL where run.jsonl will be reachable after you push it, e.g.:
# https://raw.githubusercontent.com/<you>/<repo>/main/run.jsonl
PUBLIC_LOG_URL=https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/run.jsonl
